PROFILE=dev
# Con PROFILE=dev la conexión a Oracle está en application-dev.yml; estas cuatro variables solo se usan con PROFILE=prod.
SIGREC_DB_URL=
SIGREC_DB_USERNAME=
SIGREC_DB_PASSWORD=
SIGREC_DB_SCHEMA=
SIGREC_DDL_AUTO=validate
SIGREC_SEED=never
# SPEC 039: el API no autoriza por defecto (como educalle-app). Mantener en false salvo que se defina un modelo de permisos.
SIGREC_AUTORIZACION=false
SIGREC_CORS_ORIGIN=
